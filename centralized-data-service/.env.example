# centralized-data-service — Phase B5 ENV map (2026-05-05)
# Copy to .env, fill, do not commit. Empty value = keep config-local.yml fallback.
# Reference: config/config.go applyEnvOverrides() function.

# ---------- Schema naming ----------
# Prefix for shadow/data-lake schemas. Default "shadow_".
# Change here propagates to admin (shadowSchemaFor), provisioning
# (HandleShadowBind), and sinkworker (normalizeShadowSchema). NO code
# touch needed when renaming convention to "lake_" / "raw_" / etc.
CDC_SHADOW_SCHEMA_PREFIX=shadow_

# ---------- DB DSNs (logical roles) ----------
# Legacy single-DSN view, used as control-plane DSN.
DB_SINK_URL=postgres://gpay_admin:gpay_pass@localhost:5433/cdc_dw?sslmode=disable

# Phase 01 split E2E — physical-instance DSNs.
CDC_SYSTEM_DB_URL=postgres://gpay_admin:gpay_pass@localhost:5433/cdc_dw?sslmode=disable
CDC_CONTROL_PLANE_URL=postgres://gpay_admin:gpay_pass@localhost:5433/cdc_dw?sslmode=disable
CDC_SHADOW_DB_URL=postgres://gpay_admin:gpay_pass@localhost:5433/cdc_dw?sslmode=disable
# Phase B5 split target — uncomment when shadow data đã pg_dump'd sang
# `gpay-postgres-shadow` container (cdc-docker-dev, port 5436).
# CDC_SHADOW_DB_URL=postgres://gpay_admin:gpay_pass@localhost:5436/cdc_shadow?sslmode=disable
CDC_MASTER_DB_URL=postgres://gpay_admin:gpay_pass@localhost:5434/goopay_dest?sslmode=disable
# Legacy alias kept for back-compat. DestinationURL() now derives from MasterDB.
CDC_DESTINATION_URL=postgres://gpay_admin:gpay_pass@localhost:5434/goopay_dest?sslmode=disable

# ---------- Source DSNs (Phase B5 explicit) ----------
# Each connection_code in `sources:` block has a matching env key.
# Convention: SOURCE_DSN_<KEY_UPPERCASE>.
SOURCE_DSN_POSTGRES_PRIMARY=postgres://src_user:src_pass@localhost:5435/goopay_source?sslmode=disable
SOURCE_DSN_MONGODB_PRIMARY=mongodb://localhost:17017/?directConnection=true
# Legacy field — same as SOURCE_DSN_MONGODB_PRIMARY (kept for back-compat).
MONGODB_URL=mongodb://localhost:17017/?directConnection=true

# ---------- Messaging / Cache ----------
NATS_URL=nats://cdc_worker:worker_secret_2026@localhost:14222
REDIS_URL=redis://localhost:16379

# ---------- Kafka / Debezium ----------
KAFKA_BROKERS=localhost:19092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:18081
KAFKA_CONNECT_URL=http://localhost:18083
DEBEZIUM_CONNECTOR_NAME=goopay-mongodb-cdc

# ---------- OTel / JWT ----------
OTEL_ENDPOINT=http://localhost:14318
JWT_SECRET=change-me-in-production
