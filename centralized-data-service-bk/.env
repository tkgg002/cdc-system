# centralized-data-service — runtime overrides (Phase B5.5c, 2026-05-05)
# Auto-loaded by docker-compose. KHÔNG commit (.gitignore áp dụng).

# Switch shadow DSN sang container mới `gpay-postgres-shadow` (port 5432
# bên trong cdc-bridge, port 5436 trên host) sau khi pg_dump+restore
# từ cdc_dw đã verify counts khớp 100% (54 rows).
CDC_SHADOW_DB_URL=postgres://gpay_admin:gpay_pass@gpay-postgres-shadow:5432/cdc_shadow?sslmode=disable
