# ---------- postgres-source (goopay_source on :5435) ----------
PG_SOURCE_USER=src_user
PG_SOURCE_PASSWORD=src_pass
PG_SOURCE_DATABASE=goopay_source

# ---------- postgres-shadow (cdc_shadow on :5436) ----------
PG_SHADOW_USER=gpay_admin
PG_SHADOW_PASSWORD=gpay_pass
PG_SHADOW_DATABASE=cdc_shadow

# ---------- postgres-dest (goopay_dest on :5434) ----------
PG_DEST_USER=gpay_admin
PG_DEST_PASSWORD=gpay_pass
PG_DEST_DATABASE=goopay_dest

# ---------- mongo source (gpay-mongo replSet rs0 on :17017)
MONGO_URL=mongodb://gpay-mongo:27017/?replicaSet=rs0

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=goopay_db

# ---------- MariaDB ----------
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=goopay_legacy_maria
MARIADB_USER=cdc
MARIADB_PASSWORD=cdc_pass
